{
  "name": "avs-backend",
  "version": "1.0.0",
  "description": "Backend API REST Node.js / Express / PostgreSQL / Prisma pour Agro Véto Services Congo",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "npx prisma generate",
    "postinstall": "npx prisma generate",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:deploy": "npx prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "npx prisma studio"
  },
  "keywords": [
    "nodejs",
    "express",
    "postgresql",
    "prisma",
    "render",
    "api",
    "avs"
  ],
  "author": "Agro Véto Services Congo",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^6.19.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
